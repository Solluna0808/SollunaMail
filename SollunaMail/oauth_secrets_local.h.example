#ifndef OAUTH_SECRETS_LOCAL_H
#define OAUTH_SECRETS_LOCAL_H

// ============================================================================
// SollunaMail Local OAuth 2.0 Credentials Template
// 1. Copy this file to "oauth_secrets_local.h" (ignored by Git).
// 2. Either set SOLLUNAMAIL_OAUTH_CLIENT_ID_CIPHER_HEX / SECRET_CIPHER_HEX
//    (SHA-256 stream-XOR hex) or set the _PLAIN macros below for local builds.
// ============================================================================

#define SOLLUNAMAIL_OAUTH_CLIENT_ID_CIPHER_HEX ""
#define SOLLUNAMAIL_OAUTH_CLIENT_SECRET_CIPHER_HEX ""

#define SOLLUNAMAIL_OAUTH_CLIENT_ID_PLAIN ""
#define SOLLUNAMAIL_OAUTH_CLIENT_SECRET_PLAIN ""

#endif // OAUTH_SECRETS_LOCAL_H

